# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Service role key is used ONLY in trusted server contexts (server actions / route handlers),
# never sent to the browser. Required for a couple of admin-only seed/utility scripts.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Business timezone default (spec section 73) -- can later become per-business setting.
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata